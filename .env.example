# Copy this file to `.env` and fill in your own values.
# Not needed if OPENAI_API_KEY / OPENAI_BASE_URL are already set as system
# environment variables on your machine — those take priority over .env.

OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: enables the "agnes-2.5-flash" model in the sidebar dropdown.
# https://www.agnes-ai.com/en/docs/overview
AGNES_API_KEY=your-agnes-key-here
